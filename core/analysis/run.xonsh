#!/usr/bin/env xonsh

import re, os
from pathlib import Path

STAR_OUTPUT_PATH = Path(os.environ.get("STAR_OUTPUT_PATH", "/workspace/output/bench"))
FILE_NAME = STAR_OUTPUT_PATH / "analysis.s"

cd @(Path(__file__).resolve().parent.parent)

jobs = @.env.get("CARGO_BUILD_JOBS") or $(nproc).strip()
$RUSTFLAGS = "-C debuginfo=2 -C force-frame-pointers=yes"

cargo build -j @(jobs) --bin analysis --features timecop --release

log = $(valgrind --leak-check=full --show-leak-kinds=all ./target/release/analysis 2>&1)
print(log, end="")

addresses = dict.fromkeys(re.findall(r'at (0x[0-9A-Fa-f]+):', log))

with open(FILE_NAME, "w") as out:
    out.write("=== VALGRIND OUTPUT ===\n")
    out.write(log)
    if not log.endswith("\n"):
        out.write("\n")
    out.write("\n")

    for a in addresses:
        f = int(a, 16) - 0x4000000

        out.write(f"=== A={a} F={f:#x} ===\n")
        out.write(
            $(objdump -Cd --demangle ./target/release/analysis \
                @("--start-address=" + str(f - 512)) \
                @("--stop-address=" + str(f + 512)))
        )
        out.write("\n")
