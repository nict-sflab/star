#!/usr/bin/env xonsh

import os
import re
import subprocess
from pathlib import Path

SGX_TARGET = "x86_64-fortanix-unknown-sgx"
STAR_BENCH_PATH = Path(os.environ.get("STAR_BENCH_PATH", "/workspace/star/bench"))
FILE_NAME = STAR_BENCH_PATH / "analysis.s"
ANALYSIS_DIR = Path(__file__).resolve().parent

cd @(ANALYSIS_DIR.parent)

jobs = @.env.get("CARGO_BUILD_JOBS") or $(nproc).strip()
$RUSTFLAGS = '--cfg getrandom_backend="rdrand" -C debuginfo=2 -C force-frame-pointers=yes'

cargo build -j @(jobs) --bin analysis --release --target @(SGX_TARGET)

elf = Path("target") / SGX_TARGET / "release" / "analysis"
if not elf.is_file():
    raise RuntimeError(f"SGX ELF was not produced: {elf}")

config = ANALYSIS_DIR / "checkct.ini"
cmd = [
    "binsec",
    "-sse",
    "-checkct",
    "-sse-script",
    str(config),
    "-sse-depth",
    "1000000",
    str(elf),
]

proc = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
log = proc.stdout

print("=== BINSEC CHECKCT: issue_token ===")
print(log, end="" if log.endswith("\n") else "\n")

if proc.returncode != 0 or "[checkct:error]" in log:
    raise RuntimeError("Binsec checkct failed for issue_token")

addresses = re.findall(r"Instruction (0x[0-9A-Fa-f]+) has ", log)

STAR_BENCH_PATH.mkdir(parents=True, exist_ok=True)

with open(FILE_NAME, "w") as out:
    out.write("=== BINSEC CHECKCT: issue_token ===\n")
    out.write(log)
    if not log.endswith("\n"):
        out.write("\n")
    out.write("\n")

    for address in dict.fromkeys(addresses):
        pc = int(address, 16)
        start = max(0, pc - 512)
        stop = pc + 512
        disassembly = subprocess.run(
            [
                "objdump",
                "-Cd",
                "--demangle",
                f"--start-address={start}",
                f"--stop-address={stop}",
                str(elf),
            ],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=True,
        ).stdout

        out.write(f"=== LEAK AT {address} ===\n")
        out.write(disassembly)
        if not disassembly.endswith("\n"):
            out.write("\n")
        out.write("\n")
