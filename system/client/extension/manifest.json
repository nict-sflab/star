{
  "manifest_version": 3,
  "name": "STAR",
  "version": "0.1.0",
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8080/*",
        "http://localhost:8081/*"
      ],
      "js": [
        "frontend.js"
      ]
    }
  ],
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "http://localhost:8081/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/star.js",
        "wasm/star_client_wasm.js",
        "wasm/star_client_wasm_bg.wasm"
      ],
      "matches": [
        "http://localhost:8080/*",
        "http://localhost:8081/*"
      ]
    }
  ]
}
