{
  "manifest_version": 3,
  "name": "Rust WASM Background Demo",
  "version": "0.1.0",
  "background": {
    "service_worker": "./background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "http://localhost:8081/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}